+  // p5g: fill a PDCP SDU trace row (bearer id + IPv4/UDP/RTP parse of the SDU head). Copies <= 64 bytes.
+  void p5g_fill_sdu_row(p5g::pdcp_sdu_row& row, uint32_t count, const byte_buffer& sdu) const
+  {
+    row.t         = p5g::trace_now();
+    row.ue_index  = p5g_ue_index;
+    row.rb_is_drb = p5g_rb_is_drb;
+    row.rb_id     = p5g_rb_id;
+    row.count     = count;
+    row.sdu_bytes = static_cast<uint32_t>(sdu.length());
+    uint8_t head[64];
+    size_t  n = 0;
+    for (span<const uint8_t> seg : sdu.segments()) { // segment-wise memcpy, no per-byte iterator
+      const size_t k = std::min(seg.size(), sizeof(head) - n);
+      std::memcpy(head + n, seg.data(), k);
+      n += k;
+      if (n == sizeof(head)) {
+        break;
+      }
+    }
+    p5g::parse_ip_udp_rtp(head, n, row);
+  }
+  uint32_t p5g_ue_index  = 0;
+  uint32_t p5g_rb_is_drb = 0;
+  uint32_t p5g_rb_id     = 0;
