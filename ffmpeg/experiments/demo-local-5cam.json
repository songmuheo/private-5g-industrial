{
  "tree": "ffmpeg",
  "name": "demo-local-5cam",
  "duration_s": 12,
  "start_delay_s": 6,
  "relay_host": "127.0.0.1",
  "require_gnb": false,
  "hosts": {
    "mode": "local"
  },
  "sync": {
    "mode": "off"
  },
  "receiver": {
    "extra_args": []
  },
  "_note": "MOT17-03 (1500 frames, 50 s loop) on every camera; camK's ladder is rotated to start at content frame 3K (idr_origin), so in every slot all cameras send the SAME frame number and only the IDR instants differ (3 frames = 100 ms apart). kbps = the profile's bitrate (start rung); a `profile` message with bitrate_kbps switches the rung at the camera's next IDR. Loopback smoke test.",
  "cams": {
    "cam0": {
      "fps": 30,
      "source": "mot17-03_1280x720_30",
      "idr_origin": 0,
      "rungs": [
        500,
        1000,
        1500,
        2500,
        4000
      ],
      "kbps": 1500
    },
    "cam1": {
      "fps": 30,
      "source": "mot17-03_1280x720_30",
      "idr_origin": 3,
      "rungs": [
        500,
        1000,
        1500,
        2500,
        4000
      ],
      "kbps": 1500
    },
    "cam2": {
      "fps": 30,
      "source": "mot17-03_1280x720_30",
      "idr_origin": 6,
      "rungs": [
        500,
        1000,
        1500,
        2500,
        4000
      ],
      "kbps": 1500
    },
    "cam3": {
      "fps": 30,
      "source": "mot17-03_1280x720_30",
      "idr_origin": 9,
      "rungs": [
        500,
        1000,
        1500,
        2500,
        4000
      ],
      "kbps": 1500
    },
    "cam4": {
      "fps": 30,
      "source": "mot17-03_1280x720_30",
      "idr_origin": 12,
      "rungs": [
        500,
        1000,
        1500,
        2500,
        4000
      ],
      "kbps": 1500
    }
  }
}
