# Open5GS container parameters (consumed by the stock srsRAN open5gs_entrypoint.sh).
MONGODB_IP=127.0.0.1
OPEN5GS_IP=10.53.1.2
UE_IP_BASE=10.45.0
UPF_ADVERTISE_IP=10.53.1.2
DEBUG=false
# Subscribers are read from subscriber_db.csv (mounted by docker-compose.yml); the entrypoint
# accepts either a csv file name or a single inline "imsi,key,opc_type,opc,amf,qci,ip" record.
SUBSCRIBER_DB=subscriber_db.csv
NETWORK_NAME_FULL=p5g-industrial
NETWORK_NAME_SHORT=p5g
TZ=Asia/Seoul
