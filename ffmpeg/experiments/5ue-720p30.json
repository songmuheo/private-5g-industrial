  "receiver": {
    "extra_args": []
  },
  "_note": "MOT17-03 (1500 frames, 50 s loop) on every camera; camK's ladder is rotated to start at content frame 3K (idr_origin), so in every slot all cameras send the SAME frame number and only the IDR instants differ (3 frames = 100 ms apart). kbps = the profile's bitrate (start rung); a `profile` message with bitrate_kbps switches the rung at the camera's next IDR. 1500 kbps start: 5 x 2500 exceeds the DDDSU UL capacity measured on 2026-09-30 (~10 Mbps payload).",
  "cams": {
    "cam0": {
      "fps": 30,
      "source": "mot17-03_1280x720_30",
      "idr_origin": 0,
      "rungs": [
        500,
        1000,
        1500,
        2500,
        4000
      ],
      "kbps": 1500
    },
    "cam1": {
      "fps": 30,
      "source": "mot17-03_1280x720_30",
